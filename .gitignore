# ── Environment / secrets ──────────────────────────────────────────────────
# .env holds real Firebase keys and the backend URL — never commit it.
# .env.example (checked in) shows the required shape without real values.
.env
.env.local
.env.*.local

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Build output ────────────────────────────────────────────────────────────
dist/
dist-ssr/

# ── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS junk ────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local

# ── Vite cache ──────────────────────────────────────────────────────────────
.vite/
